{
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./",
    "lib": ["esnext"],
    "target": "ESNext",
    "moduleResolution": "NodeNext",
    "module": "NodeNext",
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "declaration": true,
    "types": ["jest","mocha"],
    "isolatedModules": true
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"]
}